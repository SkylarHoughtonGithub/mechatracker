# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Matches the Bitnami Postgres Helm chart credentials in values.dev.yaml.
# For running outside k8s (task api:run), port-forward first:
#   kubectl port-forward -n mechatracker-dev svc/mechatracker-postgresql 5432:5432
DATABASE_URL=postgres://mechatracker:mechatracker@localhost:5432/mechatracker?sslmode=disable

# ── Auth — Clerk ──────────────────────────────────────────────────────────────
# CLERK_DEV_BYPASS=true skips JWT verification entirely for local dev.
# All requests are treated as user "dev_user_local" / org "dev_org_local".
# Unset this (and fill real values below) when you're ready to test auth.
CLERK_DEV_BYPASS=true
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_WEBHOOK_SECRET=

# ── Storage — DigitalOcean Spaces ─────────────────────────────────────────────
# Leave blank until you're ready to test file upload flows.
SPACES_ENDPOINT=
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
