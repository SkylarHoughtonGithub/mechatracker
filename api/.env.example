# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Matches the Bitnami Postgres Helm chart credentials in values.dev.yaml.
# For running outside k8s (task api:run), port-forward first:
#   kubectl port-forward -n mechatracker-dev svc/mechatracker-postgresql 5432:5432
DATABASE_URL=postgres://mechatracker:mechatracker@localhost:5432/mechatracker?sslmode=disable

# ── Auth — Google OAuth ───────────────────────────────────────────────────────
# DEV_AUTH_BYPASS=true skips Google ID-token verification entirely for local dev.
# All requests are treated as the dev seed user (google_sub=dev_google_sub_local).
# Only honored when ENV=development.
DEV_AUTH_BYPASS=true
# When bypass is off, these are required:
GOOGLE_CLIENT_ID=
# Optional: restrict to a Google Workspace hosted domain.
GOOGLE_ALLOWED_HD=
# 32+ byte random string for HS256 session JWT signing.
SESSION_SIGNING_KEY=
# Leave empty for localhost; set to e.g. ".mechatracker.io" in prod.
SESSION_COOKIE_DOMAIN=
# Must be false for http://localhost dev; true in prod.
SESSION_COOKIE_SECURE=false
# Session TTL — any Go duration string, e.g. "12h".
SESSION_TTL=12h

# ── Storage — DigitalOcean Spaces ─────────────────────────────────────────────
# Leave blank until you're ready to test file upload flows.
SPACES_ENDPOINT=
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
